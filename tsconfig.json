{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "erasableSyntaxOnly": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["api", "apps", "mock-server", "test", "test-e2e", "test-image"]
}
