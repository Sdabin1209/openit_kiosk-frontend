# 정적 서빙 설정(ADR 0022). 직접 만든 Node 서버(server/static.mjs)를 대체한다. 환경 변수: PORT(기본 8080), STATIC_DIR(기본 /app/dist), CONFIG_FILE(없으면 /config.json은 404).
{
	# 왜: 설정 API(관리 포트)는 쓰지 않고, 인증서 자동 발급은 하지 않는다(TLS는 게이트웨이 몫). 설정 자동 저장도 끈다(읽기 전용 파일시스템에서 동작).
	admin off
	auto_https off
	persist_config off
	# 왜 10s: Docker stop 기본 대기(10초) 안에 끝나야 SIGKILL을 피한다. 측정 안 함.
	grace_period 10s
	servers {
		# 왜 h1만: 앞단 게이트웨이가 평문 HTTP/1.1로 프록시하고 이 컨테이너는 TLS를 끝내지 않는다. 쓰지 않는 h2/h3(UDP)를 열지 않는다.
		protocols h1
		# 왜: 느린 클라이언트(slowloris) 방어는 Caddy의 서버 timeout 설정으로 얻는다. 값은 아래 ADR 0022에 출처(측정 안 함)를 적었다.
		timeouts {
			read_header 10s
			idle 60s
		}
	}
}

(secure_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; form-action 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# 마이크는 같은 출처만(키오스크 음성 입력), 카메라·위치·결제 등은 막는다. 감사 P15.
		Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Cache-Control no-store
		-Server
	}
}

:{$PORT:8080} {
	root * {$STATIC_DIR:/app/dist}

	# 로그: 표준 출력 JSON 한 줄. /healthz·/readyz와 쿼리 문자열, 요청 헤더는 남기지 않는다(쿼리에 토큰이 올 수 있고, 헤더에 자격이 있다).
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp \?.* ""
			request>headers delete
			resp_headers delete
		}
	}
	@probe path /healthz /readyz
	log_skip @probe

	import secure_headers

	route {
		@notget not method GET HEAD
		respond @notget "method not allowed" 405

		respond /healthz "ok" 200

		handle /readyz {
			@ready file {
				root {$STATIC_DIR:/app/dist}
				try_files /index.html
			}
			respond @ready "ready" 200
			respond "not ready" 503
		}

		# 기기 설정: 운영이 마운트한 파일(CONFIG_FILE)을 /config.json으로 낸다. 없으면 존재하지 않는 경로로 가서 404.
		# 토큰이 들어 있을 수 있어 내용은 로그에 쓰지 않는다. 기기 밖에서 읽히지 않게 막는 것은 게이트웨이 몫이다(CR-001).
		handle /config.json {
			header Content-Type application/json
			root * /
			rewrite * {$CONFIG_FILE:/nonexistent-config}
			file_server
		}

		redir /staff /staff/ 301
		file_server
	}

	# 왜: header 지시자는 file_server가 낸 오류(404 등)에는 적용되지 않는다. 오류 응답에도 같은 보안 헤더를 붙인다.
	handle_errors {
		import secure_headers
		respond "{err.status_code} {err.status_text}"
	}
}
