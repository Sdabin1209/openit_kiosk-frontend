{
  "service": "kiosk-frontend",
  "egress": [],
  "routes": [
    {
      "paths": [
        "/healthz",
        "/readyz"
      ],
      "auth": {
        "kind": "denied"
      }
    },
    {
      "paths": [
        "/config.json"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "none"
      },
      "user_header": "strip",
      "timeouts_ms": {
        "dial": 2000,
        "response_header": 10000
      },
      "max_body_bytes": 1024
    },
    {
      "paths": [
        "/staff/*"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "account",
        "roles": [
          "staff"
        ]
      },
      "user_header": "strip",
      "timeouts_ms": {
        "dial": 2000,
        "response_header": 10000
      },
      "max_body_bytes": 1024
    },
    {
      "paths": [
        "/*"
      ],
      "methods": [
        "GET"
      ],
      "auth": {
        "kind": "none"
      },
      "user_header": "strip",
      "timeouts_ms": {
        "dial": 2000,
        "response_header": 10000
      },
      "max_body_bytes": 1024
    }
  ]
}
