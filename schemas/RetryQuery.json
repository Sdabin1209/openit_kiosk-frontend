{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RetryQuery.json",
  "title": "RetryQuery",
  "description": "재시도 판단 입력: 지금까지 시도 횟수와 경과 시간.",
  "type": "object",
  "properties": {
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "retryAfterMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "elapsedMs": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "attempt",
    "retryAfterMs",
    "elapsedMs"
  ],
  "additionalProperties": false
}
