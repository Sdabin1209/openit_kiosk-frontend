{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ConversationEvent.json",
  "title": "ConversationEvent",
  "description": "대화 목록의 입력 이벤트. id는 같은 말풍선을 두 번 만들지 않기 위한 키(같은 turn_id의 재전송).",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "PATIENT",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "type",
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "CLEAR"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  ]
}
