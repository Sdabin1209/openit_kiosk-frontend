{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "StatusClass.json",
  "title": "StatusClass",
  "description": "응답 상태 분류 출력. retryable = 같은 요청을 자동으로 다시 보내도 된다. outcomeUnknown = 서버가 처리했는지 모른다(5xx).",
  "type": "object",
  "properties": {
    "retryable": {
      "type": "boolean"
    },
    "outcomeUnknown": {
      "type": "boolean"
    }
  },
  "required": [
    "retryable",
    "outcomeUnknown"
  ],
  "additionalProperties": false
}
