{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "KioskView.json",
  "title": "KioskView",
  "description": "키오스크 상태 기계의 출력(화면이 그리는 값). 환자 발화는 담지 않는다(text는 서버 응답 문장).",
  "type": "object",
  "properties": {
    "state": {
      "enum": [
        "IDLE",
        "CHOOSING",
        "NOT_OPEN",
        "STARTING",
        "LISTENING",
        "REPEAT_PROMPT",
        "SENDING",
        "WAITING_STAFF",
        "CALL_STAFF",
        "ENDING",
        "ENDED"
      ]
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "callStaffReason": {
      "enum": [
        "RETRY_EXHAUSTED",
        "DELIVERY_FAILED",
        "AUTH",
        "START_FAILED",
        "STAFF_REQUESTED",
        "BAD_SUBJECT_REF",
        "REPEAT_LIMIT"
      ]
    },
    "repeatReason": {
      "enum": [
        "EMPTY_STT",
        "TOO_LONG"
      ]
    },
    "retrying": {
      "type": "boolean"
    },
    "waitHint": {
      "enum": [
        "THINKING",
        "PLEASE_WAIT"
      ],
      "description": "SENDING 대기 중 화면 피드백 단계(D125, Nielsen): 1초 뒤 THINKING(진행 표시), 10초 뒤 PLEASE_WAIT(안내 문구). 없으면 아직 1초 전"
    },
    "idleWarnS": {
      "type": "integer",
      "minimum": 0,
      "description": "유휴 만료 경고 중: 만료까지 남은 초(WCAG 2.2.1)"
    },
    "textFallback": {
      "type": "boolean"
    },
    "startNotice": {
      "const": "NO_SUBJECT_REF"
    },
    "waitNotice": {
      "enum": [
        "SERVER_UNREACHABLE",
        "LONG_WAIT"
      ]
    },
    "endFailed": {
      "type": "boolean"
    },
    "confirmLeave": {
      "type": "boolean"
    },
    "pauseReason": {
      "enum": [
        "RISK",
        "REASK_LIMIT",
        "OTHER"
      ]
    },
    "staffCall": {
      "$ref": "StaffCallView.json"
    },
    "busy": {
      "type": "boolean"
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "DeviceConfig.schema.json#/properties/question_set_id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      },
      "description": "CHOOSING에서 고를 문진표(활성 목록의 ID·제목)"
    }
  },
  "required": [
    "state",
    "text"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "CALL_STAFF"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "callStaffReason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "REPEAT_PROMPT"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "repeatReason"
        ]
      }
    },
    {
      "if": {
        "required": [
          "callStaffReason"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "CALL_STAFF"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "staffCall"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "CALL_STAFF"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "CHOOSING"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "choices"
        ]
      }
    },
    {
      "if": {
        "required": [
          "choices"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "CHOOSING"
          }
        }
      }
    }
  ]
}
