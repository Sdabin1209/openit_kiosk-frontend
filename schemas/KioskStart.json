{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "KioskStart.json",
  "title": "KioskStart",
  "description": "키오스크 시작 값(메모리 전용). 형식은 계약 DeviceConfig·KioskStartFragment가 정한다.",
  "type": "object",
  "properties": {
    "deviceToken": {
      "type": [
        "string",
        "null"
      ]
    },
    "subjectRef": {
      "anyOf": [
        {
          "$ref": "DeviceConfig.schema.json#/properties/subject_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "subjectInvalid": {
      "type": "boolean",
      "description": "값이 있었지만 형식이 틀렸다. 세션을 시작하지 않고 직원을 부른다"
    },
    "allowRemoteStt": {
      "const": true,
      "description": "기기 설정이 켠 때만 있다(기본 꺼짐, D88 U3)"
    },
    "questionSetId": {
      "anyOf": [
        {
          "$ref": "DeviceConfig.schema.json#/properties/question_set_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "시작 조각 또는 기기 설정이 정한 문진표 ID(조각이 먼저). 없으면 null: 활성 목록에서 정한다"
    }
  },
  "required": [
    "deviceToken",
    "subjectRef",
    "subjectInvalid",
    "questionSetId"
  ],
  "additionalProperties": false
}
