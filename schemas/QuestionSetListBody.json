{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "QuestionSetListBody.json",
  "title": "QuestionSetListBody",
  "description": "GET /v1/question-sets 응답 본문(PUBLIC_API.md I10, 계약 3.3.0): 활성 릴리스의 문진표 목록. 받는 쪽 관대한 읽기 스키마라 모르는 키는 허용한다(ADR 0005). 항목이 비면 문진표가 준비되지 않은 것이다.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_set_id": { "$ref": "DeviceConfig.schema.json#/properties/question_set_id" },
          "title": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        },
        "required": ["question_set_id", "title", "version"]
      }
    }
  },
  "required": ["items"]
}
