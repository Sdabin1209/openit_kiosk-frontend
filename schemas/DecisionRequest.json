{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DecisionRequest.json",
  "title": "DecisionRequest",
  "description": "직원의 개입 결정 입력(확인 단계를 거친다). 같은 알림·같은 결정은 같은 turn_id로 간다.",
  "type": "object",
  "properties": {
    "alert_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "$ref": "SessionState.schema.json#/properties/session_id"
    },
    "decision": {
      "enum": [
        "RESUME",
        "END"
      ]
    }
  },
  "required": [
    "alert_id",
    "session_id",
    "decision"
  ],
  "additionalProperties": false
}
