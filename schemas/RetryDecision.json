{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RetryDecision.json",
  "title": "RetryDecision",
  "description": "재시도 판단 출력: 포기(직원 호출)이거나 대기 시간.",
  "type": "object",
  "properties": {
    "giveUp": {
      "type": "boolean"
    },
    "waitMs": {
      "type": "integer",
      "minimum": 0
