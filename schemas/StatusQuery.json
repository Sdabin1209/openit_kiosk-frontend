{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "StatusQuery.json",
  "title": "StatusQuery",
  "description": "응답 상태 분류 입력: HTTP 상태와 오류 본문 details.reason(없으면 null).",
  "type": "object",
  "properties": {
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "reason"
  ],
  "additionalProperties": false
}
