{
  "name": "kiosk-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check-schema": "node scripts/check-schema.mjs",
    "gen-validators": "node scripts/gen-validators.mjs",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "mock": "node mock-server/main.ts",
    "smoke": "bash scripts/smoke.sh",
    "test:image": "node --test --test-concurrency=1 \"test-image/*.test.ts\"",
    "test:dom": "bash scripts/dom-docker.sh",
    "test:e2e": "bash scripts/e2e-docker.sh",
    "doctor": "node scripts/doctor.mjs",
    "test:e2e:host": "node scripts/doctor.mjs --host && npm run build && node --test --test-concurrency=1 \"test-e2e/*.test.ts\""
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.19.2",
    "ajv": "8.20.0",
    "esbuild": "0.25.9",
    "jsdom": "26.1.0",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.55.1",
    "typescript": "5.9.2"
  }
}
